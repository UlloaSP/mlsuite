# Copy to .env. Private values must be filled locally, never committed.
# Generate independent random passwords/secrets for each deployed environment.
DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5430
DB_PROD=mlsuite
DB_ADMIN_USER=mlsuite_admin
DB_ADMIN_PASS=
DB_LEGACY_OWNER=mlsuite
DB_LEGACY_PASS=
DB_USER=mlsuite_app
DB_PASS=
DB_MIGRATION_USER=mlsuite_migrator
DB_MIGRATION_PASS=
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
MODEL_MUTATIONS_REQUIRE_VERSION=true
# Public bookmarks run for anyone on the shared runtime: the largest model artifact (MB) a
# public bookmark may bind, how many public runs may execute at once (more wait their turn, see
# RUNTIME_QUEUE_* below), and how many runs of one bookmark a network without a session, or an
# account, may make in 24 hours.
PUBLIC_PREDICTION_MAX_MODEL_SIZE_MB=50
PUBLIC_PREDICTION_MAX_CONCURRENT=2
PUBLIC_PREDICTION_ANONYMOUS_RUNS_PER_DAY=50
PUBLIC_PREDICTION_SIGNED_IN_RUNS_PER_DAY=500
# API clients run organizations' bookmarks from outside software: how many of their runs may
# execute at once (apart from public pages), how many calls one client may make in a clock
# minute, how many succeeded calls an organization's clients may make in a calendar month unless
# a superadmin sets its own limit, and how many days each call is kept (at least 31).
API_ACCESS_MAX_CONCURRENT=2
API_ACCESS_REQUESTS_PER_MINUTE=60
API_ACCESS_MONTHLY_CALLS=10000
API_ACCESS_REQUEST_RETENTION_DAYS=90
# Workspace members' predictions, explanations and artifact inspections that may execute at
# once, apart from public pages and API clients.
WORKSPACE_PREDICTION_MAX_CONCURRENT=4
# Runs that find their share in use wait their turn in arrival order: at most this many wait in
# each share, one caller holds at most this many places in a share (running or waiting), and a
# run waits at most this many milliseconds. Past any of them it is answered 503 with Retry-After.
RUNTIME_QUEUE_MAX_WAITING=1000
RUNTIME_QUEUE_MAX_PER_CALLER=16
RUNTIME_QUEUE_MAX_WAIT_MS=5000
# Bulk uploads run on the server as jobs: at most this many records per upload, and this many
# uploads queued or running at once per member and per organization.
PREDICTION_JOBS_MAX_ROWS=10000
PREDICTION_JOBS_MAX_OPEN_PER_MEMBER=2
PREDICTION_JOBS_MAX_OPEN_PER_ORGANIZATION=4
# The runtime runs models in at most this many worker processes in all, about one per core it may
# use; each runs one request at a time inside one model's environment, and a busy environment may
# take several. Each worker keeps the bundles it loaded while their artifacts total at most this
# many MB (the newest is kept even when larger), and the runtime keeps received artifacts on disk
# within the same bound. The memory limits bound the runtime (every worker included) and the
# builder on a shared host.
RUNTIME_WORKERS=2
RUNTIME_BUNDLE_CACHE_MB=512
RUNTIME_MEMORY_LIMIT=6g
# The builder installs the environment each uploaded model's lock names, after checking it against
# backend/environment-allowlist.toml, and only from this index (a mirror works: files are checked
# by the lock's SHA-256, never fetched from the lock's URLs).
RUNTIME_PACKAGE_INDEX_URL=https://pypi.org/simple
RUNTIME_BUILDER_MEMORY_LIMIT=2g
# Initial on-premise topology: one server and one physical disk.
# This covers logical rollback only; a disk or host loss is unrecoverable.
RECOVERY_MODE=local-single-disk
SINGLE_DISK_RISK_ACCEPTED=false
LOCAL_BACKUP_ROOT=backups
LOCAL_BACKUP_RETENTION_COUNT=7
LOCAL_BACKUP_MIN_FREE_PERCENT=15
RECOVERY_LAST_RESTORE_UTC=
RECOVERY_LAST_RTO_SECONDS=
RECOVERY_LAST_RESTORE_RESULT=
RECOVERY_RPO_MINUTES=1440
RECOVERY_RTO_MINUTES=480
RESTORE_SMOKE_PORT=18080
COMPOSE_PROJECT_NAME=mlsuite
RELEASE_COMPOSE=docker-compose.release.yml

SPRING_PORT=8080
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8000
WEB_PORT=5173
MINIO_CONSOLE_ADDRESS=:9001
MINIO_ROOT_USER=mlsuite-root
MINIO_ROOT_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
LOG_PATH=/tmp/mlsuite
CORS_ALLOW_ORIGINS=http://localhost:5173
ANALYZER_BASE_URL=http://py-analyzer:8000
RUNTIME_BUILDER_HOST=0.0.0.0
RUNTIME_BUILDER_PORT=8001
RUNTIME_BUILDER_BASE_URL=http://runtime-builder:8001
VITE_BACKEND_URL=

OPS_AGENT_BASE_URL=http://ops-agent:8091
OPS_AGENT_SHARED_SECRET=
# Signs the predictions the API runs for workspace inferences; saving accepts only results it signed.
# Required by the API: at least 32 random characters (for example `openssl rand -hex 32`).
PREDICTION_ATTESTATION_SECRET=
MLSUITE_SUPERADMIN_EMAIL=admin@example.com
MLSUITE_SUPERADMIN_PASSWORD=
MLSUITE_SUPERADMIN_FULL_NAME=MLsuite Admin
MLSUITE_SUPERADMIN_USERNAME=admin

OPS_AGENT_HOST=0.0.0.0
OPS_AGENT_PORT=8091
OPS_AGENT_DOCKER_BIN=docker
# Match the -p project used by docker compose on the host.
OPS_AGENT_COMPOSE_PROJECT=mlsuite
OPS_AGENT_MANAGED_SERVICES=postgres,py-analyzer,runtime-builder,minio,spring-app,frontend
OPS_AGENT_SAMPLE_INTERVAL_SECONDS=5
OPS_AGENT_RETENTION_MINUTES=60
OPS_AGENT_TERMINAL_SERVICES=
OPS_AGENT_TERMINAL_IDLE_MINUTES=15
OPS_AGENT_TERMINAL_MAX_SESSIONS=5
OPS_AGENT_LOG_TAIL_LINES=200

STORAGE_ENABLED=true
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=mlsuite-app
STORAGE_SECRET_KEY=
STORAGE_BUCKET=mlsuite
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_RETAIN_INLINE_COPY=true
STORAGE_DELETION_ENABLED=true
STORAGE_DELETION_BATCH_SIZE=20
STORAGE_DELETION_STALE_AFTER_SECONDS=300
ARTIFACT_MIGRATION_COMMAND=status
ARTIFACT_MIGRATION_MAX_ATTEMPTS=5
ARTIFACT_MIGRATION_STALE_AFTER_SECONDS=900
ARTIFACT_MIGRATION_ORPHAN_GRACE_SECONDS=86400
