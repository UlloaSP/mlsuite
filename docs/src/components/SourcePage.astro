---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getEntry, render } from "astro:content";
import { sourcePages } from "../sources";
import { repositoryUrl } from "../sites";

interface Props {
  file: (typeof sourcePages)[number]["file"];
}

const { file } = Astro.props;
const entry = await getEntry("sources", file);
if (!entry) throw new Error(`Missing source ${file}`);
const { Content, headings } = await render(entry);
const page = sourcePages.find((source) => source.file === file)!;
---

<StarlightPage
  frontmatter={{
    title: entry.data.title,
    description: `${page.label} for MLsuite, rendered from ${file} in the repository.`,
    editUrl: `${repositoryUrl}/edit/develop/${file}`,
  }}
  headings={headings.filter(({ depth }) => depth > 1)}
>
  <p class="source-file">
    Source: <a href={`${repositoryUrl}/blob/main/${file}`}><code>{file}</code></a>. This page
    renders that file unchanged.
  </p>
  <Content />
</StarlightPage>
