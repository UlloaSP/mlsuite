---
import Default from "@astrojs/starlight/components/Footer.astro";
import { appUrl, repositoryUrl } from "../sites";
---

<Default />
<div class="brand-footer">
  <span
    >MLsuite is part of <a href="https://eshkra.dev">eshkra</a>, open-source tools for models people
    can use.</span
  >
  <span class="links">
    <a href={repositoryUrl}>GitHub</a>
    <a href={appUrl}>Live instance</a>
    <a href={`${repositoryUrl}/blob/main/LICENSE`}>MIT license</a>
  </span>
</div>

<style>
  .brand-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--msu-border);
    color: var(--msu-text-3);
    font-size: 0.8125rem;
  }
  .links {
    display: inline-flex;
    gap: 1.25rem;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--msu-ember-ink);
  }
</style>
