---
import { Image } from "astro:assets";
import mark from "../assets/mlsuite.png";
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<span class="brand-title">
  <a href={siteTitleHref} class="mlsuite-brand" aria-label="MLsuite documentation home">
    <Image src={mark} width={64} alt="" loading="eager" />
    <span class="mlsuite-wordmark" translate="no">
      <span class="ml">ML</span><span class="rest">suite</span>
    </span>
  </a>
  <a class="parent-brand" href="https://eshkra.dev">by eshkra</a>
</span>

<style>
  .brand-title {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }
  .mlsuite-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--msu-text);
    font-size: 1.55rem;
    text-decoration: none;
  }
  /* The mark is wider than tall (960 x 512), so it is sized by height. */
  .mlsuite-brand :global(img) {
    width: auto;
    height: 1.6rem;
    object-fit: contain;
  }
  .mlsuite-wordmark {
    font-family: var(--brand-font-sans);
    white-space: nowrap;
  }
  .ml {
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.01em;
  }
  .rest {
    font-weight: 300;
    font-stretch: 100%;
  }
  @media (max-width: 40rem) {
    .parent-brand {
      display: none;
    }
  }
</style>
