---
import { Icon } from "@astrojs/starlight/components";
import { appUrl, landingUrl, repositoryUrl } from "../sites";
---

<a class="nav-link" href={landingUrl}>Product</a>
<a href={repositoryUrl} rel="me" class="icon-link sl-flex">
  <span class="sr-only">MLsuite on GitHub</span>
  <Icon name="github" />
</a>
<a class="open-app" href={appUrl}>
  Open MLsuite <Icon name="external" size="0.9rem" />
</a>

<style>
  .nav-link,
  .icon-link {
    color: var(--msu-text-2);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .icon-link {
    padding: 0.5em;
    margin: -0.5em;
  }
  .nav-link:hover,
  .icon-link:hover {
    color: var(--msu-text);
  }
  .open-app {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: var(--msu-text);
    color: var(--msu-bg);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .open-app:hover {
    background: var(--msu-ember-ink);
    color: #fff;
  }
  @media (forced-colors: active) {
    .open-app {
      border: 1px solid ButtonText;
    }
  }
</style>
