{
  "name": "mlsuite-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp exec astro dev --host 127.0.0.1 --port 4351",
    "start": "vp run dev",
    "build": "vp run typecheck && vp exec astro build",
    "check": "vp run typecheck && vp run test",
    "preview": "vp exec astro preview --host 127.0.0.1 --port 4351",
    "typecheck": "vp exec astro check",
    "test": "vp exec node --test src/sources.test.ts",
    "check:deploy": "vp exec wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.1",
    "astro": "7.3.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "vite-plus": "1.3.0",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
